# ============================================================
# AgentForge — environment configuration
# Copy to .env (make setup) and fill in real values.
# ============================================================

# --- Core ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database (pgvector/postgres 16) ---
# In docker compose the host becomes `postgres` (overridden per-service).
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge

# --- Redis (cache, celery results, short-term memory) ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (celery broker) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# --- Auth / JWT ---
# CHANGE-ME: generate with `openssl rand -hex 32`
JWT_SECRET=CHANGE-ME-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM provider keys (all optional — the platform degrades to stubs without them) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Local models via Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434

# --- Observability ---
# LangSmith tracing (optional)
LANGSMITH_API_KEY=

# --- Object storage (S3-compatible: AWS S3, MinIO, R2) — for document uploads ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentforge

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
